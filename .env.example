# Copy to .env (or set these in your hosting control panel) for the live site.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=d4interiors.com,www.d4interiors.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://d4interiors.com,https://www.d4interiors.com
# Set to True if your host has no separate setting for serving /media/ uploads.
DJANGO_SERVE_MEDIA=False

# Who receives an email when someone sends the quote or contact form (comma separated)
INQUIRY_NOTIFY_EMAILS=owner@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=D4 Interiors <your-account@gmail.com>
